{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?path=:path*" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" },
    { "key": "Cache-Control", "value": "no-store" }
  ]}]
}
